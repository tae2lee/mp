<?xml version="1.0" encoding="utf-8"?>
<!-- 좌석 서버(210.119.152.17)는 https 를 지원하지 않아 이 주소에만 http 를 허용한다.
     다른 주소는 안드로이드 기본값(https 만 허용)을 그대로 따른다. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">210.119.152.17</domain>
    </domain-config>
</network-security-config>
